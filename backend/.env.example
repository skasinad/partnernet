# Copy to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True

# Comma-separated. Add your Render hostname in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Local dev uses SQLite automatically. In production set this to the
# Postgres URL Render gives you (postgres://user:pass@host:5432/dbname).
# DATABASE_URL=postgres://...

# Frontend origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Set to True in production (behind Render's HTTPS proxy).
DJANGO_SECURE_SSL_REDIRECT=False
